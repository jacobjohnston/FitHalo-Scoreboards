{
  "version": 2,
  "description": "All weekly challenge data and the sharing it needs. A field is allowed when every entry in its requires holds: score and activity at least the level named, in the order given by levels; routes, strengthSets and strengthWeights true. An object or array is allowed when anything beneath it is. A client never sends a field it is not allowed; a server strips any it receives and never serves one. A field missing from this file is allowed at no level, so adding a field to a weekly challenge means adding it here.",
  "levels": {
    "score": [
      "progress",
      "score",
      "details"
    ],
    "activity": [
      "none",
      "points",
      "summary",
      "full"
    ]
  },
